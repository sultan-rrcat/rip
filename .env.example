# Secrets + host-local deploy keys only.
# All tuning defaults live in backend/app/core/config.py (single source of truth).

# Host port mappings (compose)
HOST_BACKEND_PORT=8005
HOST_FRONTEND_PORT=5173
HOST_PG_PORT=5436

# Database — host-local uses 127.0.0.1 (bare localhost hangs on Windows);
# compose overrides DB_HOST=postgres via docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5436
DB_NAME=rip
DB_USER=rip
DB_PASSWORD=

# Ollama — host-local hits the LAN address directly; compose interpolates
# ${OLLAMA_BASE_URL:-http://host.docker.internal:11434}.
OLLAMA_BASE_URL=http://10.10.30.77:21434
OLLAMA_DEFAULT_MODEL=ornith-1.5:9b

# Embedding models (absolute host-local paths; compose overrides to /app/backend/models/...).
BGE_M3_MODEL_PATH=D:/models/bge-m3
BGE_RERANKER_V2_M3=D:/models/reranker/bge_reranker_v2_m3

# Langfuse (optional; get keys from the Langfuse UI — org settings → API keys)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
