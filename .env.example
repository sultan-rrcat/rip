
HOST_BACKEND_PORT=8005
HOST_FRONTEND_PORT=5175


# Database — compose postgres fresh bootstrap (TARGET: rip/rip/rippass).
# Host-local uses 127.0.0.1 — bare localhost hangs on Windows;
# in-compose backend uses DB_HOST=postgres:5432 via docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5436
HOST_PG_PORT=5436
DB_CONNECT_TIMEOUT_S=5
DB_NAME=rip
DB_USER=rip
DB_PASSWORD=rippass

# Ollama — remote endpoint preserved from legacy LLM_URL.
# Host-local hits the LAN address directly; in-compose needs the
# override (host gateway + remote port) — see compose override file.
OLLAMA_BASE_URL=http://10.10.30.77:21434
OLLAMA_DEFAULT_MODEL=ornith-1.5:9b
OLLAMA_TIMEOUT_MS=300000

# Embedding models (absolute host-local paths; verified on D:).
# In-compose overridden to /app/backend/models/... (see docker-compose.yml).
BGE_M3_MODEL_PATH=D:/models/bge-m3
BGE_RERANKER_V2_M3=D:/models/reranker/bge_reranker_v2_m3

# Server
PORT=8005
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Upload
UPLOAD_DIR=./backend/uploads

# PDF ingestion: docling | opendataloader (default docling).
# Selected loader runs first; the other is the fallback.
RAG_PDF_LOADER=docling

# Model defaults
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=2048
DEFAULT_TIMEOUT_MS=60000
# Per-task output budgets (cap generated tokens only; they do not extend
# OLLAMA_CONTEXT_WINDOW). Coding inlines whole files + emits test scripts,
# so it gets headroom; chat is greetings/small-talk and stays cheap.
# Builders set these per step; any step may override via input max_tokens.
CODING_MAX_TOKENS=32768
CHAT_MAX_TOKENS=1024

# Chat memory + retrieved context
# OLLAMA_CONTEXT_WINDOW must equal the Ollama server's OLLAMA_CONTEXT_LENGTH:
# the provider posts to /v1/chat/completions, where num_ctx is silently ignored,
# so this value does not size the server window (ADR-033).
OLLAMA_CONTEXT_WINDOW=32768
MEMORY_WINDOW_SIZE=10
SUMMARY_THRESHOLD_PCT=0.7
SUMMARY_MAX_TOKENS=512
# Share of the context window one whole-file rag.query dump may fill before
# falling back to ranked retrieval (ADR-033). Per-shard: up to 5 file-scoped
# shards share one reduce prompt. Set 0 to disable the shortcut.
RAG_WHOLE_FILE_PCT=0.15

# Observability (optional; Athena pattern — no-op unless ENABLED=true + keys)
# Stack: separate compose project (athena/external/docker-compose.langfuse.yml),
# web UI on host :3002. Get keys from the Langfuse UI (org settings → API keys).
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3002
LANGFUSE_SECRET_KEY="sk-lf-3d278e71-cb63-4e63-9d84-727a50f03b99"
LANGFUSE_PUBLIC_KEY="pk-lf-0a062765-53a1-4e3d-876e-55ce96580e33"
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=dev
