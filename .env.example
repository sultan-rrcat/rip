# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rip
DB_USER=rip
DB_PASSWORD=rippass

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_MS=120000

# Embedding models (absolute paths; relative resolves to repo-root absolute)
# Host-local example: BGE_M3_MODEL_PATH=D:/models/bge-m3
# In-compose overridden to /app/backend/models/... (see docker-compose.yml).
BGE_M3_MODEL_PATH=/abs/path/to/backend/models/bge-m3
BGE_RERANKER_V2_M3=/abs/path/to/backend/models/reranker/bge_reranker_v2_m3
# Aliases honored by config (do not delete — local boot needs them):
# BGE_MODEL_DIR=/abs/path/to/backend/models/bge-m3
# RERANKER_MODEL_DIR=/abs/path/to/backend/models/reranker/bge_reranker_v2_m3

# Server
PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Upload
UPLOAD_DIR=./backend/uploads

# Model defaults
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=2048

# Code sandbox
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_MEMORY=256m
SANDBOX_TIMEOUT_MS=30000

# Observability (optional; Athena pattern — no-op unless ENABLED=true + keys)
# Stack: separate compose project (athena/external/docker-compose.langfuse.yml),
# web UI on host :3002. Get keys from the Langfuse UI (org settings → API keys).
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3002
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=dev
